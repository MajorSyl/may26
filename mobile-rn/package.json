{
  "name": "rcfs-mobile",
  "description": "Rotary Club of Freetown Sunset app — React Native (Expo, TypeScript) for iOS, Android, and web from a single codebase, backed by Supabase.",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "@expo/metro-runtime": "~4.0.1",
    "expo-asset": "~11.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-web": "~0.19.13",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-gesture-handler": "~2.20.2",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react-native": "^0.469.0",
    "react-native-svg": "15.8.0",
    "nativewind": "4.1.23",
    "tailwindcss": "^3.4.14",
    "react-native-url-polyfill": "^2.0.0"
  },
  "overrides": {
    "react-native": "0.76.5",
    "react-native-reanimated": "~3.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.3.3"
  }
